# Copy to apps/web/.env.local, or run pnpm backend:bootstrap after Supabase start.
# Never commit populated files. Provider keys are entered only through Settings.
NEXT_PUBLIC_DATA_MODE=mock
NEXT_PUBLIC_ENABLE_DEVTOOLS=false
APP_BASE_URL=http://localhost:3000
# Generated 32-byte base64 key; keep backups. Losing it loses stored integrations.
APP_ENCRYPTION_KEY=
APP_KEY_VERSION=1
LOCAL_OWNER_ID=
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
N8N_BASE_URL=http://localhost:5678
# One-time public API key from n8n Settings; the MCP token is a different credential.
N8N_API_KEY=
N8N_WEBHOOK_SECRET=
N8N_CALLBACK_SECRET=
N8N_INTERNAL_APP_URL=http://host.docker.internal:3000
N8N_INTERNAL_SUPABASE_URL=http://host.docker.internal:54321
# Compose only: preserve an existing instance's encryption key when adopting it.
N8N_ENCRYPTION_KEY=
COMPILER_SERVICE_URL=http://localhost:8000
COMPILER_MODE=server
# Enable only for local test providers; public deployments require proper Auth.
ALLOW_LOCAL_PROVIDER_URLS=true
ENABLE_DEVTOOLS=false
GENERATION_IDLE_TIMEOUT_MS=180000
GENERATION_MAX_TIMEOUT_MS=900000
