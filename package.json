{
  "name": "naskah",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "postinstall": "node scripts/prepare-assets.mjs",
    "dev": "pnpm --filter @naskah/web dev",
    "build": "pnpm --filter @naskah/web build",
    "start": "pnpm --filter @naskah/web start",
    "typecheck": "pnpm --filter @naskah/core typecheck && tsc -p n8n/tsconfig.json && pnpm --filter @naskah/web typecheck",
    "lint": "eslint apps/web/src packages/contracts/src packages/core/src",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "audit:slop": "node scripts/audit-slop.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "n8n:build": "tsx n8n/generate-schema.ts && node n8n/build.mjs",
    "n8n:deploy": "node scripts/run-server-script.mjs deploy",
    "test:b5": "node scripts/run-server-script.mjs test",
    "n8n:verify-markdown": "node scripts/deploy-renderer.mjs",
    "local:setup-mock": "node scripts/setup-local-mock.mjs",
    "test:b6": "node scripts/run-server-script.mjs b6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "esbuild": "0.25.12",
    "eslint": "10.13.0",
    "fflate": "0.8.3",
    "prettier": "3.9.10",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
